{
  "//": "JavaScript project. Kept only for the @ path alias and the auto-generated src/routeTree.gen.ts.",
  "include": ["src/**/*.js", "src/**/*.jsx", "src/routeTree.gen.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./src/*"] }
  }
}
